# Copy this file to .env. Generate two different values with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
HMAC_SECRET_KEY=

APP_ENV=development
DATABASE_PATH=data/secure_bank_manager.db
AUTO_INITIALIZE_DATABASE=0

CURRENCY=PKR
TIMEZONE=Asia/Karachi
MINIMUM_OPENING_BALANCE=1000.00
MINIMUM_ACCOUNT_BALANCE=0.00
DEFAULT_WITHDRAWAL_LIMIT=250000.00
DEFAULT_MAKER_CHECKER_THRESHOLD=50000.00

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
SESSION_TIMEOUT=1800
LOGIN_RATE_LIMIT=10 per minute
MFA_RATE_LIMIT=5 per minute
RECOVERY_RATE_LIMIT=3 per minute
RATE_LIMIT_STORAGE_URI=memory://

# Set to 1 only behind HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
